#!/usr/bin/env python3

import json
import os
import sys
import time


def _prompt(args: list[str]) -> str:
    if "-p" in args:
        index = args.index("-p")
        if index + 1 < len(args):
            return args[index + 1]
    return args[-1] if args else ""


def main() -> int:
    args = sys.argv[1:]
    if "--version" in args:
        print("kimi mock 1.0.0")
        return 0

    if not args:
        # Shell bootstrap mode: mirror a real `kimi` shell init so that
        # `eval "$(kimi)"` (and `kimi` run bare in `bash -lic`) succeed and
        # export the expected provider auth + base URL.
        print('export ANTHROPIC_API_KEY="${AGENTFLOW_KIMI_MOCK_API_KEY:-mock-key}"')
        print('export ANTHROPIC_BASE_URL="https://api.kimi.com/coding/"')
        return 0

    prompt = _prompt(args)

    if "[slow]" in prompt:
        time.sleep(float(os.getenv("AGENTFLOW_MOCK_SLOW_SECONDS", "5")))

    response = os.getenv("AGENTFLOW_KIMI_MOCK_RESPONSE", "").strip()
    if not response:
        response = prompt

    print(json.dumps({"role": "assistant", "content": response}), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
